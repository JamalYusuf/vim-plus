{
  "name": "vim-plus",
  "description": "Vim+ — keyboard-first navigation for Google Chrome by Jamal Yusuf",
  "author": "Jamal Yusuf",
  "private": true,
  "homepage": "https://jamalyusuf.github.io/vim-plus/",
  "license": "Apache-2.0",
  "keywords": [
    "vimium",
    "vim-plus",
    "chrome-extension",
    "keyboard",
    "shortcut",
    "chrome"
  ],
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "pngjs": "^7.0.0",
    "terser": "^5.19.0",
    "typescript": "^4.9.1"
  },
  "devDependencies": {
    "clean-css": "^5.3.2",
    "deepcopy": "^2.1.0",
    "gulp": "^4.0.2",
    "gulp-changed": "^4.0.3",
    "gulp-concat": "*",
    "gulp-newer": "*",
    "gulp-print": "^5.0.2",
    "gulp-some": "*",
    "gulp-typescript": "^6.0.0-alpha.1",
    "html-minifier": "^4.0.0",
    "rimraf": "^5.0.1",
    "rollup": "^3.26.2",
    "seedrandom": "^3.0.5"
  },
  "engines": {
    "node": ">=14",
    "npm": ">=7"
  },
  "optionalDependencies": {
    "@typescript-eslint/eslint-plugin": "^4.26.0",
    "@typescript-eslint/parser": "^4.26.0",
    "eslint": "^7.29.0"
  },
  "scripts": {
    "tsc": "node scripts/tsc.js",
    "watch": "node scripts/tsc.js --watch",
    "dev": "node scripts/tsc.js --watch",
    "all": "gulp tsc",
    "prepare": "node scripts/icons-to-blob.js -q",
    "lint": "node ./scripts/eslint.js",
    "eslint": "node ./scripts/eslint.js",
    "build": "gulp build",
    "dist": "npm run chrome",
    "package": "node scripts/package-extension.js",
    "package:store": "node scripts/package-extension.js",
    "store": "node scripts/package-extension.js",
    "extension": "node scripts/package-extension.js --keep-key --no-zip",
    "rebuild": "gulp rebuild",
    "chrome": "bash -c \"BUILD_BTypes=1 BUILD_MinCVer=${BUILD_MinCVer:-121} BUILD_NeedCommit=1 gulp dist && IN_DIST=1 ./scripts/make.sh\"",
    "csize": "bash -c \"BUILD_BTypes=${BUILD_BTypes:-1} BUILD_MinCVer=${BUILD_MinCVer:-121} BUILD_NeedCommit=0 gulp content/size\"",
    "debug": "bash -c \"BUILD_MinCVer=${BUILD_MinCVer:-121} gulp local2\"",
    "chromium": "npm run chrome",
    "clean": "gulp clean",
    "clear": "gulp clean",
    "local": "gulp local",
    "start": "gulp local",
    "test": "gulp test"
  },
  "version": "1.0.0"
}
